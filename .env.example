# Salin file ini ke .env dan isi dengan nilai asli
# cp .env.example .env

BOT_TOKEN=123456789:AABBCCDDEEFFaabbccddeeff1234567890
CHAT_ID=987654321

# Ambang batas alert
RAM_THRESHOLD=20      # persen available, di bawah ini = alert
DISK_THRESHOLD=85     # persen used, di atas ini = alert
SWAP_THRESHOLD=80     # persen swap used, di atas ini = alert

# Cooldown agar tidak spam (detik)
COOLDOWN_SECONDS=3600
